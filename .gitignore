# Any crate's build directory, not only the workspace root: the example
# guests are separate workspaces with their own target/.
target/
**/*.rs.bk
Cargo.lock.bak
.env
.env.*
!.env.example
.idea/
.vscode/
*.iml
.DS_Store
/wasm-cache/

# OpenTofu/Terraform working directory: vendored provider binaries, hundreds of
# MB, re-fetched by `tofu init`. The lock file IS committed — it pins provider
# versions and belongs under review.
deploy/tofu/.terraform/
