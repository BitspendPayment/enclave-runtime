#!/usr/bin/env bash
# The one thing the parent needs that the image cannot know: which device is
# the pool's disk, written where nbdkit.service picks it up. The enclave's own
# settings — bucket, region, domains — are in the image and measured into PCR0;
# nothing here reaches it.
#
# Not a place for secrets. This file is readable from the instance metadata
# service by anything on the box, and the parent is the party the enclave
# excludes.
set -euxo pipefail

# The pool's EBS volume, for nbdkit to serve over vsock.
mkdir -p /etc/enclave
cat > /etc/enclave/disk.env <<ENV
POOL_DISK=${pool_disk}
ENV

systemctl daemon-reload
systemctl restart nbdkit.service enclave.service || true
